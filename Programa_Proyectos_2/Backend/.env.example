# Reemplazar USER, PASSWORD y HOST por la conexion real de Supabase (Connect).
# Copiar esta linea sin reemplazar los valores NO configura la base de datos.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_NAME=EcoLogistica Lima API
ECOLOGISTICA_DEBUG=false
